{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "fichas3.5": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "sass"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/fichas3.5",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "sass",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/pink-bluegrey.css",
              "src/styles.sass",
              "src/tailwind.css"
            ],
            "allowedCommonJsDependencies": [
              "pako",
              "sweetalert2",
              "file-saver"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "6mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "24kb",
                  "maximumError": "36kb"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.qa.ts"
                }
              ]
            },
            "qa": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.qa.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "fichas3.5:build:production"
            },
            "development": {
              "buildTarget": "fichas3.5:build:development",
              "proxyConfig": "proxy.qa.json"
            },
            "qa": {
              "buildTarget": "fichas3.5:build:qa",
              "host": "127.0.0.14",
              "port": 443,
              "ssl": true,
              "sslCert": "C:/Users/Yosi/yosiftware-cuentas/certificados-desarrollo/certificates/_.dev.yosiftware.es.crt",
              "sslKey": "C:/Users/Yosi/yosiftware-cuentas/certificados-desarrollo/certificates/_.dev.yosiftware.es.key",
              "proxyConfig": "proxy.qa.json",
              "allowedHosts": [
                "rol.dev.yosiftware.es"
              ],
              "headers": {
                "Content-Security-Policy": "default-src 'self'; script-src 'self' https://qa-cuentas.yosiftware.es https://estadisticas.yosiftware.es; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://qa-cuentas-api.yosiftware.es; connect-src 'self' ws://127.0.0.1:8011 https://qa-cuentas-api.yosiftware.es wss://qa-cuentas-ws.yosiftware.es https://estadisticas.yosiftware.es https://*.googleapis.com https://*.firebasedatabase.app wss://*.firebasedatabase.app; frame-src https://qa-cuentas.yosiftware.es; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'",
                "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
              }
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "fichas3.5:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "karmaConfig": "karma.conf.js",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "sass",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/pink-bluegrey.css",
              "src/styles.sass"
            ],
            "scripts": []
          }
        },
        "deploy": {
          "builder": "@angular/fire:deploy",
          "options": {
            "prerender": false,
            "ssr": false,
            "browserTarget": "fichas3.5:build:production",
            "firebaseProject": "yosiftware-fichas",
            "firebaseHostingSite": "yosiftware-fichas"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "d7ad4a72-fcc0-4ced-8355-4454568cfe9d"
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
